# URL base del microservicio FastAPI (sin slash final).
# Déjala vacía (o no definas esta variable) para usar rutas relativas: el
# proxy de Vite (ver vite.config.ts) reenvía /predecir a
# http://127.0.0.1:8000 sin problemas de CORS.
# Solo defínela si el microservicio está en otro host/puerto y tiene CORS
# habilitado.
VITE_API_BASE_URL=
